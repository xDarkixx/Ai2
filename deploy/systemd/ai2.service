[Unit]
Description=Ai2 AI Companion platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__AI2_USER__
WorkingDirectory=__AI2_DIR__
EnvironmentFile=__AI2_DIR__/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node scripts/start-all.js
Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=__AI2_DIR__

[Install]
WantedBy=multi-user.target
