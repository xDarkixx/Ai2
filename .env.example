# Ai2 configuration
# Use test for a zero-network local integration test, or ollama for a real local model.
LLM_PROVIDER=test

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter - free routing (requires a free API key)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

# Local Ollama - run scripts/install-local-models.ps1 or scripts/install-local-models.sh first.
# Smallest recommended model: qwen3:0.6b-q4_K_M
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b-q4_K_M
AI2_LOCAL_MODELS=qwen3:0.6b-q4_K_M,gemma3:1b,llama3.2:1b
OLLAMA_MAX_TOOL_LOOPS=4
# Alternatives: gemma3:1b, llama3.2:1b

# Any OpenAI-compatible endpoint
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=

# Optional native C++ bridge
# Linux/macOS: ./build/ai2_native
# Windows: .\\build\\Release\\ai2_native.exe
AI2_NATIVE_BINARY=./build/ai2_native

# Wan 2.5 cloud video generation
WAN_API_KEY=
WAN_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
WAN_T2V_MODEL=wan2.5-t2v-preview
WAN_I2V_MODEL=wan2.5-i2v-preview
WAN_POLL_INTERVAL_MS=15000
WAN_POLL_TIMEOUT_MS=900000

# Wan 2.2 local backend (weights are NOT stored in Ai2)
WAN22_ENABLED=false
# Windows example: C:/AI/Wan2.2
WAN22_ROOT=/path/to/Wan2.2
# Windows example: C:/AI/Wan2.2-TI2V-5B
WAN22_CKPT=/path/to/Wan2.2-TI2V-5B
# Windows: python.exe or full path such as C:/Python312/python.exe
WAN22_PYTHON=python
WAN22_DEFAULT_SIZE=1280*704
WAN22_TIMEOUT_MS=1800000

# Node backend listens locally; NGINX exposes it on port 80.
PORT=3000
