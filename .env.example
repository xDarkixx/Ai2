# Ai2 configuration
LLM_PROVIDER=demo

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Local Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Any OpenAI-compatible endpoint
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=

# Optional native C++ bridge
AI2_NATIVE_BINARY=./build/ai2_native

# Wan 2.5 video generation (keep the API key out of git)
WAN_API_KEY=
WAN_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
WAN_T2V_MODEL=wan2.5-t2v-preview
WAN_I2V_MODEL=wan2.5-i2v-preview
WAN_POLL_INTERVAL_MS=15000
WAN_POLL_TIMEOUT_MS=900000

PORT=3000
