# Ai2 LLM configuration
# demo = no external API key, local simulated replies
LLM_PROVIDER=demo

# Google Gemini free tier (where available)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Groq free/developer tier (limits vary)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter free models (availability/limits vary)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b:free

# Any OpenAI-compatible endpoint
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=

PORT=3000
