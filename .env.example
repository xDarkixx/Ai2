# Ai2 configuration
LLM_PROVIDER=test
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:0.6b-q4_K_M
AI2_LOCAL_MODELS=qwen3:0.6b-q4_K_M,gemma3:1b,llama3.2:1b
OLLAMA_MAX_TOOL_LOOPS=4
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=
AI2_NATIVE_BINARY=./build/ai2_native
WAN_API_KEY=
WAN_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
WAN_T2V_MODEL=wan2.5-t2v-preview
WAN_I2V_MODEL=wan2.5-i2v-preview
WAN_POLL_INTERVAL_MS=15000
WAN_POLL_TIMEOUT_MS=900000
WAN22_ENABLED=false
WAN22_ROOT=/path/to/Wan2.2
WAN22_CKPT=/path/to/Wan2.2-TI2V-5B
WAN22_PYTHON=python
WAN22_DEFAULT_SIZE=1280*704
WAN22_TIMEOUT_MS=1800000
AI2_TOKEN_PORT=3010
AI2_ADMIN_TOKEN=
AI2_RATE_LIMIT_PER_MINUTE=120
AI2_ADMIN_CONTROL_PORT=3011
AI2_PAYMENT_PORT=3020
AI2_PAYMENT_BASE_URL=http://127.0.0.1:3020
AI2_PAYMENT_SECRET=change-this-to-a-long-random-server-secret
AI2_PAYMENT_PUBLIC_CHECKOUT=false
AI2_PAYMENT_ALLOWED_ORIGIN=http://localhost:3000
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLUS=
STRIPE_PRICE_PRO=
STRIPE_PORTAL_CONFIGURATION_ID=
PAYMENT_SUCCESS_URL=http://localhost:3000/?payment=success
PAYMENT_CANCEL_URL=http://localhost:3000/?payment=cancelled
# Local ComfyUI. Model weights stay outside the Ai2 repository.
COMFYUI_ENABLED=true
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_HOST=127.0.0.1
COMFYUI_PORT=8188
COMFYUI_GATEWAY_PORT=3030
PORT=3000
